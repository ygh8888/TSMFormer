{
    "name": "Gesture Recognition",
    "dataset": "NVGestures",
    "epochs": 100,
    "phase": "test",
    "data": {
        "optical_flow": false,
        "type": "depth",
        "n_classes": 25,
        "n_frames": 40,
        "data_path": "/data/NVGesture",
        "result_dir": "./result",
        "batch_size": 8,
        "csv_dir": "./experiments/BL5_revision/NVGestures/csv/",
        "full_train": false
    },
    "checkpoints": {
        "save_policy": "best",
        "save_name": "rev_nvgestures_depth",
        "save_dir": "./experiments/BL5_revision/NVGestures/checkpoints/",
        "save_iters": 30,
        "tb_path": "./experiments/BL2_tsm/NVGestures/train_log"
    },
    "solver": {
        "type": "AdamW",
        "workers": 4,
        "weight_decay": 0.0001,
        "base_lr": 0.0001,
        "decay_steps": [
            50,
            75
        ]
    },
    "network": {
        "backbone": "resnet",
        "pretrained": true,
        "ff_size": 1024,
        "n_head": 8,
        "dropout2d": 0.1,
        "dropout1d": 0.5,
        "n_module": 6,
        "use_tsm": true
    },
    "resume": "experiments/BL5_revision/NVGestures/checkpoints/NVGestures/best_rev_nvgestures_depth.pth"
}